{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/download.js": {
      "includeFiles": "private/**/*.pdf"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
